{
	"compilerOptions": {
		"moduleResolution": "NodeNext",
		"target": "ESNext",
		"module": "NodeNext",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"checkJs": true,
		"types": ["node"],
		"lib": ["ESNext", "DOM", "DOM.Iterable"]
	},
	"include": ["./computer-control", "./renderer", "./preload.cjs"]
}
